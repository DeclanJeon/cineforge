{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cineforge/qa_report.schema.json",
  "title": "검수 리포트",
  "type": "object",
  "properties": {
    "gate": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    },
    "checked_at": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warn",
              "info"
            ]
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "rule",
          "severity",
          "message"
        ]
      }
    },
    "summary": {
      "type": "object"
    }
  },
  "required": [
    "gate",
    "status",
    "issues"
  ]
}
