{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cineforge/ssot_character.schema.json",
  "title": "Character SSOT",
  "type": "object",
  "properties": {
    "ssot_type": {
      "type": "string",
      "enum": [
        "character"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string"
    },
    "source_hash": {
      "type": "string"
    },
    "locked": {
      "type": "boolean"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "age": {
                "type": [
                  "integer",
                  "string",
                  "null"
                ]
              },
              "role": {
                "type": "string"
              },
              "persona": {
                "type": "string"
              },
              "appearance": {
                "type": "string"
              },
              "identity_anchor": {
                "type": "string"
              },
              "wardrobe": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "scenes": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    }
                  },
                  "required": [
                    "id",
                    "description",
                    "scenes"
                  ]
                }
              },
              "voice": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "description"
                ]
              },
              "consent": {
                "type": "object",
                "properties": {
                  "real_person": {
                    "type": "boolean"
                  },
                  "likeness_consent": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  }
                },
                "required": [
                  "real_person",
                  "likeness_consent"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "identity_anchor",
              "wardrobe",
              "voice",
              "consent"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "characters"
      ]
    },
    "upstream_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      },
      "description": "작성 시점의 상위 SSOT 버전"
    }
  },
  "required": [
    "ssot_type",
    "version",
    "source_hash",
    "locked",
    "depends_on",
    "data"
  ]
}
