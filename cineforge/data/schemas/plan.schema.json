{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cineforge/plan.schema.json",
  "title": "제작 기획안(Plan)",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "generated_by": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "logline": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string"
        },
        "genres": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime_s": {
          "type": "number"
        },
        "scene_count": {
          "type": "integer"
        },
        "cut_count": {
          "type": "integer"
        },
        "aspect": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "narrative": {
          "type": "string"
        },
        "strategy": {
          "type": "string"
        }
      },
      "required": [
        "format",
        "genres",
        "runtime_s",
        "scene_count",
        "cut_count",
        "aspect",
        "style",
        "narrative",
        "strategy"
      ]
    },
    "synopsis": {
      "type": "string"
    },
    "hook": {
      "type": "object",
      "properties": {
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        },
        "line": {
          "type": [
            "string",
            "null"
          ]
        },
        "visual": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "start",
        "end",
        "visual",
        "caption",
        "questions"
      ]
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          },
          "label": {
            "type": "string"
          },
          "scene_no": {
            "type": "integer"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "label",
          "scene_no"
        ]
      },
      "minItems": 1
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "no": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          },
          "location": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "cuts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "no": {
                  "type": "integer"
                },
                "duration": {
                  "type": "number",
                  "minimum": 0.1
                },
                "shot": {
                  "type": "string"
                },
                "visual": {
                  "type": "string"
                },
                "sound": {
                  "type": "string"
                },
                "dialogue": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "speaker": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "characters": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "state": {
                  "type": "object"
                },
                "motion": {
                  "type": "object",
                  "properties": {
                    "headline": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 48
                    },
                    "detail": {
                      "type": "string",
                      "maxLength": 48
                    },
                    "option": {
                      "type": "string",
                      "maxLength": 48
                    },
                    "reply": {
                      "type": "string",
                      "maxLength": 48
                    },
                    "select_frame": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "reply_frame": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "steps": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 3,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 28
                      }
                    },
                    "reveal_frames": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 3,
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "from_shape": {
                      "enum": [
                        "square",
                        "rounded_square",
                        "circle"
                      ]
                    },
                    "to_shape": {
                      "enum": [
                        "square",
                        "rounded_square",
                        "circle"
                      ]
                    },
                    "morph_start_frame": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "morph_end_frame": {
                      "type": "integer",
                      "minimum": 2
                    },
                    "layout": {
                      "enum": [
                        "stack",
                        "carousel",
                        "compare"
                      ]
                    },
                    "cards": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 3,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 24
                      }
                    },
                    "poster": {
                      "enum": [
                        "editorial",
                        "pop",
                        "dark"
                      ]
                    },
                    "type_reveal": {
                      "type": "object",
                      "properties": {
                        "phrases": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 3,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 24
                          }
                        },
                        "reveal_frames": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 3,
                          "items": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      },
                      "required": [
                        "phrases",
                        "reveal_frames"
                      ],
                      "additionalProperties": false
                    },
                    "connector_frames": {
                      "type": "integer",
                      "minimum": 2
                    },
                    "burst": {
                      "type": "object",
                      "properties": {
                        "at_frame": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "seed": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 65535
                        }
                      },
                      "required": [
                        "at_frame",
                        "seed"
                      ],
                      "additionalProperties": false
                    },
                    "entrance": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "enum": [
                            "wipe_left",
                            "wipe_right"
                          ]
                        },
                        "duration_frames": {
                          "type": "integer",
                          "minimum": 2
                        }
                      },
                      "required": [
                        "kind",
                        "duration_frames"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "headline"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "no",
                "duration",
                "visual",
                "sound"
              ]
            },
            "minItems": 1
          },
          "direction_note": {
            "type": "string"
          }
        },
        "required": [
          "no",
          "title",
          "start",
          "end",
          "location",
          "cuts"
        ]
      },
      "minItems": 1
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "age": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          },
          "role": {
            "type": "string"
          },
          "persona": {
            "type": "string"
          },
          "appearance": {
            "type": "string"
          },
          "wardrobe": {
            "type": "string"
          },
          "voice": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "persona",
          "appearance",
          "wardrobe"
        ]
      },
      "minItems": 1
    },
    "props": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "production_spec": {
      "type": "object",
      "properties": {
        "aspect": {
          "type": "string"
        },
        "fps": {
          "type": "string"
        },
        "camera": {
          "type": "string"
        },
        "lighting": {
          "type": "string"
        },
        "edit": {
          "type": "string"
        },
        "camera_movement": {
          "type": "string"
        },
        "bgm": {
          "type": "string"
        },
        "sfx": {
          "type": "string"
        },
        "grading": {
          "type": "string"
        },
        "subtitles": {
          "type": "string"
        },
        "motion_recipe": {
          "type": "object",
          "properties": {
            "recipe": {
              "enum": [
                "kinetic_type",
                "ui_state",
                "diagram_data",
                "shape_morph",
                "card_sequence",
                "character_photo",
                "brand_product",
                "realtime_3d",
                "image_reveal",
                "chart_bars",
                "paper_layers",
                "map_route"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "recipe",
            "reason"
          ]
        },
        "motion_brief": {
          "type": "object",
          "properties": {
            "analysis": {
              "type": "object",
              "required": [
                "audience_task",
                "message_units",
                "format_hint",
                "platform",
                "duration",
                "assets",
                "data_sources",
                "audio",
                "brand",
                "constraints",
                "delivery"
              ]
            },
            "candidates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "format",
                  "recipe",
                  "reason"
                ],
                "properties": {
                  "format": {
                    "enum": [
                      "showreel",
                      "product_film",
                      "explainer",
                      "character_short",
                      "realtime_3d",
                      "logo_bumper",
                      "edit_assist",
                      "other"
                    ]
                  },
                  "recipe": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scores": {
                    "type": "object"
                  }
                }
              }
            },
            "choice": {
              "type": "object",
              "required": [
                "format",
                "recipe",
                "reason"
              ],
              "properties": {
                "format": {
                  "enum": [
                    "showreel",
                    "product_film",
                    "explainer",
                    "character_short",
                    "realtime_3d",
                    "logo_bumper",
                    "edit_assist",
                    "other"
                  ]
                },
                "recipe": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "route_by_cut": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "cut",
                  "route"
                ],
                "properties": {
                  "cut": {
                    "type": "string",
                    "minLength": 1
                  },
                  "route": {
                    "enum": [
                      "local",
                      "code",
                      "realtime_3d",
                      "downgrade"
                    ]
                  },
                  "downgrade": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "required": [
            "analysis",
            "candidates",
            "choice",
            "route_by_cut"
          ]
        }
      },
      "required": [
        "aspect",
        "fps",
        "camera",
        "lighting",
        "edit",
        "camera_movement",
        "bgm",
        "sfx",
        "grading",
        "subtitles"
      ]
    },
    "preflight_checks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "title",
    "logline",
    "meta",
    "synopsis",
    "hook",
    "timeline",
    "scenes",
    "characters",
    "production_spec"
  ]
}
