{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cineforge/handoff.schema.json",
  "title": "스킬 인계 패킷(Handoff)",
  "type": "object",
  "properties": {
    "stage": {
      "type": "string"
    },
    "route": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner_entrypoints": {
      "type": "array",
      "items": {"type": "string"}
    },
    "craft_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "guide": {"type": "string"},
    "skill_pack": {
      "type": "object",
      "required": ["name", "version", "contract_version", "manifest_sha256", "inventory_sha256", "root"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "contract_version": {"type": "integer"},
        "manifest_sha256": {"type": "string"},
        "inventory_sha256": {"type": "string"},
        "root": {"type": "string"}
      }
    },
    "authority_required": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority_granted": {
      "type": "boolean"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs_expected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "packet": {
      "type": "object"
    },
    "completion_command": {
      "type": "string"
    }
  },
  "required": [
    "stage",
    "owner_skills",
    "inputs",
    "outputs_expected",
    "completion_command"
  ]
}
