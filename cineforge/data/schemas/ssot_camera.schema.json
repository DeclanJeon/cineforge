{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cineforge/ssot_camera.schema.json",
  "title": "Camera SSOT",
  "type": "object",
  "properties": {
    "ssot_type": {
      "type": "string",
      "enum": [
        "camera"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string"
    },
    "source_hash": {
      "type": "string"
    },
    "locked": {
      "type": "boolean"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "cuts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cut_id": {
                "type": "string"
              },
              "shot_size": {
                "type": "string"
              },
              "lens_mm": {
                "type": "integer"
              },
              "angle": {
                "type": "string"
              },
              "movement": {
                "type": "string"
              },
              "axis_side": {
                "type": "string",
                "enum": [
                  "A",
                  "B"
                ]
              },
              "screen_direction": {
                "type": ["string", "null"]
              },
              "crosses_axis": {
                "type": "boolean"
              }
            },
            "required": [
              "cut_id",
              "shot_size",
              "lens_mm",
              "movement",
              "axis_side"
            ]
          }
        }
      },
      "required": [
        "cuts"
      ]
    },
    "upstream_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      },
      "description": "작성 시점의 상위 SSOT 버전"
    }
  },
  "required": [
    "ssot_type",
    "version",
    "source_hash",
    "locked",
    "depends_on",
    "data"
  ]
}
