{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cineforge/ssot_audio.schema.json",
  "title": "Audio SSOT",
  "type": "object",
  "properties": {
    "ssot_type": {
      "type": "string",
      "enum": [
        "audio"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string"
    },
    "source_hash": {
      "type": "string"
    },
    "locked": {
      "type": "boolean"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "voices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "character_id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "character_id",
              "type",
              "description"
            ]
          }
        },
        "music_themes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "license": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "description",
              "license"
            ]
          }
        },
        "ambience": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "location_id": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "location_id",
              "description"
            ]
          }
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cue_id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "OST",
                  "BGM",
                  "AMBIENCE",
                  "AMB",
                  "SFX",
                  "DIALOGUE",
                  "VO",
                  "SILENCE"
                ]
              },
              "tc_in": {
                "type": "number"
              },
              "tc_out": {
                "type": "number"
              },
              "cut_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": {
                "type": "string"
              },
              "level": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "license": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              },
              "vocal": {
                "type": "boolean"
              },
              "role": {
                "type": "string"
              }
            },
            "required": [
              "cue_id",
              "type",
              "tc_in",
              "tc_out",
              "description",
              "source",
              "license"
            ]
          }
        }
      },
      "required": [
        "voices",
        "music_themes",
        "ambience",
        "cues"
      ]
    },
    "upstream_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      },
      "description": "작성 시점의 상위 SSOT 버전"
    }
  },
  "required": [
    "ssot_type",
    "version",
    "source_hash",
    "locked",
    "depends_on",
    "data"
  ]
}
